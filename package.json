    "hex-color-to-color-name": "^2.0.1",
    "isbot": "^5.1.36",
    "react": "^19.2.5",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.4",
    "react-router": "7.14.0",
    "string-ts": "^2.3.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.14.0",
